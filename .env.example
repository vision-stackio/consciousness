# Pick ONE provider (or leave empty to use only the local mind).
# Provider is auto-detected from whichever key is set; LLM_PROVIDER forces it.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=ollama          # anthropic | openai | openrouter | ollama
# LLM_MODEL=                   # override the default model
# LLM_BASE_URL=                # e.g. http://localhost:11434/v1 for Ollama / LM Studio
# LLM_VISION=false             # set false if your model can't read images

PORT=8787
MAX_THINKS_PER_MINUTE=12
